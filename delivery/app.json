{
  "expo": {
    "name": "LocalMart-Delivery",
    "slug": "LocalMart-Delivery",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "localmart",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.localmart.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "LocalMart needs your location to show nearby shops and calculate delivery distances.",
        "NSCameraUsageDescription": "LocalMart needs camera access to let shopkeepers take product photos."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#10B981",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "com.localmart.app",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#10B981"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "LocalMart needs your location to show nearby shops."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "LocalMart needs photo access for product images."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#10B981"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "your-eas-project-id"
      }
    }
  }
}
